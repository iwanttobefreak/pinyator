# Copia este fichero a .env y rellena los valores.
# .env no se versiona; este ejemplo sí.
FLASK_ENV=development
PYTHONUNBUFFERED=1

# Genera una clave con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# SQLite dentro del contenedor; el volumen lo define compose.dev.yaml
DATABASE_URL=sqlite:////app/data/pinyator-dev.db?timeout=20
